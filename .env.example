# Flagsmith server-side environment key (Environment Settings -> Keys). Not the admin API key.
FLAGSMITH_ENVIRONMENT_KEY=
# Optional: only for self-hosted Flagsmith
# FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# FLAGSMITH_EVENTS_URL=http://localhost:8000/api/

# Free-tier LLM provider (Groq or Gemini). Model is configurable.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=

# Secret used to sign the anonymous identity cookie
COOKIE_SECRET=
